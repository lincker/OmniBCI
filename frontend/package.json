{
  "name": "omnibci-console",
  "version": "0.1.0",
  "private": true,
  "description": "OmniBCI Web console — read-only MVP (stage 1). Types generated from the backend OpenAPI spec.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "codegen": "openapi-typescript ../docs/openapi.json -o src/api/rest-types.ts",
    "codegen:check": "openapi-typescript ../docs/openapi.json -o /tmp/rest-types.check.ts && diff -q /tmp/rest-types.check.ts src/api/rest-types.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  }
}
