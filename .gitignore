### VirtualEnv template
# Virtualenv
# http://iamzed.com/2009/05/07/a-primer-on-virtualenv/
[Bb]in
[Ii]nclude
[Ll]ib
[Ll]ib64
[Ll]ocal
/[Ss]cripts/
# ^ venv-template rule (Windows venv Scripts/). The project's own entry-point
# scripts live in scripts/ at the repo root — re-include them explicitly.
!/scripts/
pyvenv.cfg
.venv
pip-selfcheck.json

# Ignore dynaconf secret files
.secrets.*

# backup files
/backup

# plugin implementations — vendor/user plugin packages are not committed
# until reviewed. Framework files directly under plugins/ (registry, factory,
# loader, plugin_catalog, dirs) ARE tracked. The first-party file-reader and
# Neuroscan acquisition plugins are tracked; keep other acquisition plugins ignored.
/omnibci/infrastructure/plugins/acquisition/*
!/omnibci/infrastructure/plugins/acquisition/file/
!/omnibci/infrastructure/plugins/acquisition/file/**
/omnibci/infrastructure/plugins/acquisition/file/__pycache__/
!/omnibci/infrastructure/plugins/acquisition/neuroscan/
/omnibci/infrastructure/plugins/acquisition/neuroscan/*
!/omnibci/infrastructure/plugins/acquisition/neuroscan/scan45/
!/omnibci/infrastructure/plugins/acquisition/neuroscan/curry8/
/omnibci/infrastructure/plugins/algorithms/*
!/omnibci/infrastructure/plugins/algorithms/decoders/
!/omnibci/infrastructure/plugins/algorithms/decoders/**
!/omnibci/infrastructure/plugins/algorithms/epoch/
!/omnibci/infrastructure/plugins/algorithms/epoch/**
!/omnibci/infrastructure/plugins/algorithms/filters/
/omnibci/infrastructure/plugins/algorithms/filters/*
!/omnibci/infrastructure/plugins/algorithms/filters/baseline_correction.py
/omnibci/infrastructure/plugins/algorithms/**/__pycache__/
# The first-party logger effector is reviewed framework code; keep other
# effector implementations ignored until they are reviewed individually.
/omnibci/infrastructure/plugins/effectors/*
!/omnibci/infrastructure/plugins/effectors/logger/
!/omnibci/infrastructure/plugins/effectors/logger/**
/omnibci/infrastructure/plugins/effectors/logger/__pycache__/
# Track only the reviewed Classic40SSVEP runtime and its compiled frame pack.
/omnibci/infrastructure/plugins/paradigms/*
!/omnibci/infrastructure/plugins/paradigms/__init__.py
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/
/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/*
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/__init__.py
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/feedback_display.py
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/frame_pack.py
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/manifest.toml
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/ssvep.py
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/resource/
/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/resource/*
!/omnibci/infrastructure/plugins/paradigms/classic40SSVEP/resource/classic40_ssvep.ofp

# user config profiles — machine-specific, never committed
/omnibci/conf/profiles/

# stimulation picture
/omnibci/infrastructure/stimulation/creator/stim/*
*.png
*.jpg
