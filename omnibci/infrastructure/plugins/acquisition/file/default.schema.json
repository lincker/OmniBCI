{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data_file_path": {
      "type": "string",
      "title": "Recording path",
      "default": "",
      "x-widget": "file-path",
      "x-scope": "machine",
      "x-apply": "module",
      "minLength": 0
    },
    "file_reader_chunk_size": {
      "type": "integer",
      "title": "Chunk size (samples)",
      "default": 100,
      "x-scope": "portable",
      "x-apply": "module",
      "minimum": 1
    },
    "sample_rate": {
      "type": "integer",
      "title": "Sample rate (Hz)",
      "default": 1000,
      "x-scope": "portable",
      "x-apply": "module",
      "minimum": 1
    },
    "channel_number": {
      "type": "integer",
      "title": "Output rows including event row",
      "default": 10,
      "x-scope": "portable",
      "x-apply": "module",
      "minimum": 2
    }
  },
  "required": [
    "data_file_path",
    "file_reader_chunk_size",
    "sample_rate",
    "channel_number"
  ]
}
