{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "DATA_PROVIDER_IP": {
      "type": "string",
      "title": "Device host",
      "default": "127.0.0.1",
      "x-scope": "machine",
      "x-apply": "module",
      "minLength": 1
    },
    "DATA_PROVIDER_PORT": {
      "type": "integer",
      "title": "TCP port",
      "default": 4455,
      "x-scope": "machine",
      "x-apply": "module",
      "minimum": 1,
      "maximum": 65535
    },
    "sample_rate": {
      "type": "integer",
      "title": "Expected sample rate (Hz)",
      "x-scope": "portable",
      "x-apply": "module",
      "minimum": 1
    },
    "channel_count": {
      "type": "integer",
      "title": "Expected output rows including event row",
      "x-scope": "portable",
      "x-apply": "module",
      "minimum": 2
    },
    "channel_labels": {
      "type": "array",
      "title": "Channel labels including event row",
      "description": "Native channel labels in output row order, including the final trigger row.",
      "items": {"type": "string"},
      "x-scope": "portable",
      "x-apply": "module"
    }
  },
  "required": [
    "DATA_PROVIDER_IP",
    "DATA_PROVIDER_PORT"
  ]
}
